# ==============================================================================
# PR Review Agent - Environment Configuration Template
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==============================================================================

# LLM Verifier Settings
PR_REVIEW_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
PR_REVIEW_BACKEND=transformers
PR_REVIEW_QUANTIZATION=4bit
PR_REVIEW_DEVICE=auto

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here
GITHUB_ALLOWED_REPOS=owner/repo1,owner/repo2
